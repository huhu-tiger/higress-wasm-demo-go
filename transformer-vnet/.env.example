# Transformer-VNet 测试环境配置文件
# 复制此文件为 .env 并填入实际的认证信息

# API 认证配置
# 如果需要 Bearer Token 认证
AUTH_TOKEN=your_bearer_token_here

# 如果需要 API Key 认证
API_KEY=your_api_key_here

# 如果需要基础认证
AUTH_USERNAME=your_username
AUTH_PASSWORD=your_password

# 自定义认证头（可选）
# 格式: HEADER_NAME=header_value
CUSTOM_AUTH_HEADER=
CUSTOM_AUTH_VALUE=

# API 配置
API_URL=http://172.22.221.212/v1/images/generations
TIMEOUT=60

# 测试配置
SERVICE_TIMEOUT=60
TEST_ENABLED=true